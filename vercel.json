{
  "redirects": [
    {
      "source": "/slr",
      "destination": "https://arva-slr.vercel.app/slr/",
      "permanent": true
    },
    {
      "source": "/slr/:path*",
      "destination": "https://arva-slr.vercel.app/slr/:path*",
      "permanent": true
    },
    {
      "source": "/arverse",
      "destination": "https://arverse.vercel.app/",
      "permanent": true
    },
    {
      "source": "/arverse/:path*",
      "destination": "https://arverse.vercel.app/:path*",
      "permanent": true
    }
  ]
}